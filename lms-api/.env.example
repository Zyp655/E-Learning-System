APP_ENV=development
SERVER_PORT=8000
SERVER_HOST=http://localhost:8000
WEB_URL=http://localhost:3000
# Browser origins allowed to open WebSockets (comma-separated); same-host and Origin-less clients are always allowed
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo dataset: seeded by default only in development/dev/local/test. Outside development it requires
# SEED_DEMO_DATA=true plus SEED_DEMO_PASSWORD (>= 8 chars, not 123456), otherwise startup fails.
# SEED_DEMO_DATA=
# SEED_DEMO_PASSWORD=

# PostgreSQL + pgvector
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=lms_confusion
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh
# Outside APP_ENV=development the API refuses DB_PASSWORD=lms_password (unless DB_DRIVER=sqlite) and the MinIO
# default S3 keys; DB_FALLBACK_SQLITE defaults to true only in development.
DB_FALLBACK_SQLITE=true

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=lms-confusion-super-secret-jwt-key-2026-min-32-chars
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_HOURS=168

# OpenAI (GPT-4o-mini Vision, Whisper-1, text-embedding-3-small, TTS-1)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# S3 / MinIO Media Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lms-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# Messaging Queue
MESSAGING_BROKER=postgres

# Confusion Detection Thresholds
CONFUSION_ML_THRESHOLD=0.60
CONFUSION_RULE_THRESHOLD=35
CONFUSION_COOLDOWN_SECONDS=300
FACE_SIMILARITY_THRESHOLD=0.55
